# Copy to .env and adjust for your environment.
PORT=5000
SITECITY_URL=http://test-api.xml.agency/SiteCity
API_LOGIN=test
API_PASSWORD=test
TOKEN_GUID=00000000-0000-0000-0000-000000000000
DEVICE_ID=test

# Currency we ASK THE PROVIDER to quote in. The provider prices natively:
# requesting INR returns real INR fares (e.g. DEL->BOM about 8795 INR), so no
# exchange-rate guessing is needed.
CURRENCY=INR
LANGUAGE=EN
REQUEST_TIMEOUT_MS=30000

# The provider already quotes in BASE_CURRENCY, so no conversion is applied.
# Only enable this if you deliberately switch CURRENCY to something else and
# want a fixed multiplier applied; it is a hard-coded guess, not a live rate.
PRICE_CONVERSION_ENABLED=false
BASE_CURRENCY=INR
SOURCE_CURRENCY_RATE=0

# AeroBook creates a REAL booking. While true, POST /api/book validates the
# request and returns the payload it would send, without transmitting it.
# Set to false only when you intend to create real bookings.
BOOK_DRY_RUN=true
