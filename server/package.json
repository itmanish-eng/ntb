{
  "name": "nowtobook-server",
  "version": "1.0.0",
  "description": "Node.js backend proxy that integrates the SiteCity SOAP API (AeroSearch) with the Nowtobook flight search frontend.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test/selftest.js",
    "test:live": "node test/seatmap-live.js",
    "probe:currency": "node tools/currency-probe.js"
  },
  "keywords": [
    "sitecity",
    "soap",
    "flights",
    "nowtobook",
    "proxy"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
